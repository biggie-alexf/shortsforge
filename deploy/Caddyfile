# Без домена: self-signed TLS на IP (браузер предупредит один раз — принять).
# Когда будет домен: заменить ":443" на "домен.тld" — сертификат выпустится сам.
:443 {
	tls internal
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /media/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
:80 {
	redir https://{host}{uri}
}
