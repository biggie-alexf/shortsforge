# Self-signed на голом IP: сайт назван явно, иначе Caddy не знает, для чего
# выпускать внутренний сертификат (браузеры не шлют SNI для IP-адресов).
# С доменом: заменить адрес сайта на домен и убрать local_certs.
{
	local_certs
}
https://178.104.185.191 {
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /media/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
