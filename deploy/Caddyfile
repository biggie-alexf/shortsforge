# ВРЕМЕННО: вход по обычному HTTP на голом IP (TLS без домена не завёлся в связке
# self-signed + no-SNI + сеть RU). С доменом: вернуть https-сайт, Caddy выпустит LE сам.
:80 {
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /media/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
